<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Emit XML docs next to the DLL so GM.Documentation can discover them at
             AppContext.BaseDirectory and feed the summaries into the OpenAPI schema. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.0.1" />
        <PackageReference Include="GM.Documentation" Version="1.3.0" />
    </ItemGroup>

    <ItemGroup>
        <Resource Include="Assets\swagger.css">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Resource>
        <Resource Include="Assets\swagger.js">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Resource>
    </ItemGroup>

</Project>
